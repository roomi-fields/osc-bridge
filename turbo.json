{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "GRILLHOUSE_RESULTATS",
    "GRILLHOUSE_CHANGEMENTS",
    "GRILLHOUSE_AVANCEMENT",
    "TMPDIR",
    "GRILLHOUSE_TRAVAILLEURS",
    "CARGO_HOME",
    "RUSTUP_HOME"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "grillhouse:gardes": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "gardes": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["build"],
      "env": ["GRILLHOUSE_TESTS"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "outputs": []
    },
    "//#grillhouse:gardes": {
      "dependsOn": [
        "osc-bridge#build"
      ],
      "outputs": []
    },
    "//#gardes": {
      "dependsOn": [
        "osc-bridge#build"
      ],
      "outputs": []
    }
  }
}
