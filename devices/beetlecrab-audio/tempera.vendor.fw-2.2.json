  "commands": [
    {
      "osc": "/canvas/load",
      "_notes": "Switch current canvas. Sends MIDI Program Change on the device channel. Tempera loads the canvas whose alphabetical index in the current folder matches `program`.",
      "args": [
        {
          "name": "program",
          "type": "u7",
          "range": [0, 127]
        }
      ],
      "frame": [192, "{program}"]
    },
    {
      "osc": "/emitters/place_by_cell",
      "_notes": "Place an emitter at a grid cell via Note-On (alternative to CC 11). Notes 0-91 map column-by-column across the grid (8 rows per column, octave-shifted).",
      "args": [
        {
          "name": "note",
          "type": "u7",
          "range": [0, 91]
        },
        {
          "name": "velocity",
          "type": "u7",
          "range": [1, 127]
        }
      ],
      "frame": [144, "{note}", "{velocity}"]
    },
    {
      "osc": "/emitters/select_active_by_note",
      "_notes": "Select the active emitter via Note-On (alternative to CC 10). Note 96 = Emitter 1, 97 = Emitter 2, 98 = Emitter 3, 99 = Emitter 4.",
      "args": [
        {
          "name": "note",
          "type": "u7",
          "range": [96, 99]
        }
      ],
      "frame": [144, "{note}", 127]
    },
    {
      "osc": "/tracks/arm",
      "_notes": "Arm a track for recording via Note-On. Note 100 = Track 1 ... 107 = Track 8. No CC equivalent is documented; this is the only way to arm tracks over MIDI.",
      "args": [
        {
          "name": "note",
          "type": "u7",
          "range": [100, 107]
        }
      ],
      "frame": [144, "{note}", 127]
    }
  ],
