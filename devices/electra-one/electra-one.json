  "custom_commands": [
    {
      "osc": "/routes/list",
      "script": "ctx = ...\nfor _, r in ipairs(ob.list_routes()) do\n  ob.emit_osc('/electra1/routes/entry', r.osc_addr, r.channel, r.cc, r.page or -1, r.min, r.max)\nend\nob.emit_osc('/electra1/routes/done')\nreturn ctx"
    },
    {
      "osc": "/preset/current",
      "script": "ctx = ...\nob.emit_osc('/electra1/preset/current', ob.state.preset_name or '')\nreturn ctx"
    },
    {
      "osc": "/page/current",
      "script": "ctx = ...\nlocal p = ob.get_current_page()\nob.emit_osc('/electra1/page/current', p or -1)\nreturn ctx"
    },
    {
      "osc": "/preset/upload",
      "profile": "preset_ingest",
      "wrap_sysex": false,
      "script": "ctx = ...\nlocal json_str = ctx.args_str[1]\nlocal p = ob.json_decode(json_str)\nif not p then ob.log_error('preset upload: json decode failed'); return nil end\nob.clear_routes()\nlocal page_idx = {}\nif p.pages then\n  for i, pg in ipairs(p.pages) do page_idx[pg.id] = i end\nend\nlocal dev_ch = {}\nif p.devices then\n  for _, d in ipairs(p.devices) do dev_ch[d.id] = (d.channel or 1) - 1 end\nend\nif p.controls then\n  for _, c in ipairs(p.controls) do\n    local vals = c.values\n    if vals and vals[1] and vals[1].message then\n      local m = vals[1].message\n      local page = page_idx[c.pageId]\n      if m.type == 'cc7' and m.parameterNumber then\n        local ch = dev_ch[m.deviceId] or 0\n        local name = (c.name or ('ctrl_' .. tostring(c.id))):lower():gsub('[^%w]+', '_'):gsub('^_+',''):gsub('_+$','')\n        local addr = string.format('/electra1/page%d/%s', page or 0, name)\n        ob.register_cc_route(page, ch, m.parameterNumber, addr, m.min or 0, m.max or 127)\n      end\n    end\n  end\nend\nob.state.preset_name = p.name\n-- Default current_page to the first page in the preset. Without this, a\n-- preset that is uploaded but whose /page/switched reply has not yet fired\n-- would have current_page=nil, and routes registered with page=N would not\n-- resolve until the user manually changes page on the device.\nif p.pages and p.pages[1] then ob.set_current_page(1) end\n-- Electra MK2 firmware 4.x: preset upload is a single SysEx (no arm step).\n-- Opcode 0x01 = upload, resource 0x01 = Preset. Target slot is whatever was\n-- previously selected via /preset/arm_upload (mis-named in this spec — it's\n-- really 'Set Preset Slot', 0x14 0x08 bank slot). Device replies ACK or NACK.\nlocal data = {0x01, 0x01}\nfor i = 1, #json_str do data[#data + 1] = string.byte(json_str, i) end\nob.emit_sysex(data, true)\nreturn ctx"
    }
  ]
