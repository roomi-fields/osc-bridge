target/
Cargo.lock
*.swp
.DS_Store

# Bulk-import caches (populated by scripts/sync_sources.py)
.cache/

# Local auth files (never commit)
.electra_auth.json
.auth.json
__pycache__/

# RTFM local database
.rtfm/

# Runtime artifacts from hardware testing
bridge.log
bridge.err
listen.log
listen.err
test-preset.json

# Local / user-specific harness configs
.claude/
.mcp.json
CLAUDE.md

# Machine-local files: scratch space, local-only config overrides,
# experiment caches. scripts/sync_sources.py reads an optional
# .local/sources.toml for local source-declaration overrides.
.local/

# npm wrapper artifacts. vendor/ is populated by the postinstall download
# on the user's machine; node_modules/ and *.tgz are local build output.
npm/vendor/
npm/node_modules/
npm/*.tgz

# mcp-publisher: the CLI binary (downloaded on demand) and its auth token
# caches — never commit
.mcpregistry_*
mcp-publisher

# Smithery MCPB bundle — built from mcpb/ on demand, not source
*.mcpb
