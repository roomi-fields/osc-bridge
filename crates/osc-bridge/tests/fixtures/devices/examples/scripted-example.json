{
  "$schema": "https://w3id.org/osd/0.7/device.schema.json",
  "device": {
    "name": "Scripted Example",
    "vendor": "osc-bridge",
    "device_id": [],
    "osc_prefix": "/example",
    "rate_limit_hz": 0
  },
  "capabilities": [
    "lua"
  ],
  "sysex": {
    "header": [
      240,
      127,
      0,
      0
    ]
  },
  "cc_params": {
    "channel": 0,
    "entries": [
      {
        "osc": "/volume_scaled",
        "transform": "return math.floor(value * 127 / 1000)",
        "ways": [
          {
            "ctrlType": "cc",
            "ctrlIndex": [
              7
            ],
            "range": [
              0,
              127
            ]
          }
        ]
      }
    ]
  },
  "commands": [
    {
      "osc": "/xorcmd",
      "args": [
        {
          "name": "a",
          "type": "u7"
        },
        {
          "name": "b",
          "type": "u7"
        },
        {
          "name": "c",
          "type": "u7"
        }
      ],
      "frame": [
        16,
        {
          "arg": "a"
        },
        {
          "arg": "b"
        },
        {
          "arg": "c"
        }
      ],
      "script": "local ctx = ...; local sum = 0; for i = 5, #ctx.payload - 1 do sum = sum ~ ctx.payload[i] end; table.insert(ctx.payload, #ctx.payload, sum & 0x7F); return ctx"
    }
  ],
  "midi_in": [
    "cc"
  ],
  "replies": [],
  "_note": "Demonstrates the Lua escape hatch. Uses `transform` on a CC param (exp curve 0..1000 → 0..127) and `script` on a command (appends an XOR checksum). Prefer declarative when possible; this device exists only to exercise the feature.",
  "identity": {
    "manufacturerId": [
      127,
      0,
      0
    ]
  }
}
