{
  "$schema": "https://w3id.org/osd/0.5/device.schema.json",
  "device": {
    "name": "Bitwig Studio",
    "vendor": "Bitwig",
    "revision": "Bitwig Studio 5 + DrivenByMoss (latest)",
    "osc_prefix": "/bitwig",
    "kind": "software",
    "transport": {
      "kind": "osc",
      "host": "127.0.0.1",
      "port": 8000,
      "reply_port": 9000
    }
  },
  "commands": [
    {
      "osc": "/transport/play",
      "forward": {
        "path": "/play",
        "args": [
          1
        ]
      }
    },
    {
      "osc": "/transport/stop",
      "forward": {
        "path": "/stop",
        "args": []
      }
    },
    {
      "osc": "/transport/tempo",
      "args": [
        {
          "name": "bpm",
          "type": "float",
          "range": [
            20,
            666
          ]
        }
      ],
      "forward": {
        "path": "/tempo/raw",
        "args": [
          {
            "arg": "bpm"
          }
        ]
      }
    },
    {
      "osc": "/transport/tap",
      "forward": {
        "path": "/tempo/tap",
        "args": [
          1
        ]
      }
    },
    {
      "osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/volume"
      ],
      "args": [
        {
          "name": "n",
          "type": "int",
          "range": [
            1,
            8
          ]
        },
        {
          "name": "v",
          "type": "float",
          "range": [
            0,
            1
          ]
        }
      ],
      "forward": {
        "path": [
          "/track/",
          {
            "capture": "n"
          },
          "/volume"
        ],
        "args": [
          {
            "arg": "v"
          }
        ]
      }
    },
    {
      "osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/mute"
      ],
      "args": [
        {
          "name": "n",
          "type": "int",
          "range": [
            1,
            8
          ]
        },
        {
          "name": "on",
          "type": "bool"
        }
      ],
      "forward": {
        "path": [
          "/track/",
          {
            "capture": "n"
          },
          "/mute"
        ],
        "args": [
          {
            "arg": "on"
          }
        ]
      }
    },
    {
      "osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/solo"
      ],
      "args": [
        {
          "name": "n",
          "type": "int",
          "range": [
            1,
            8
          ]
        },
        {
          "name": "on",
          "type": "bool"
        }
      ],
      "forward": {
        "path": [
          "/track/",
          {
            "capture": "n"
          },
          "/solo"
        ],
        "args": [
          {
            "arg": "on"
          }
        ]
      }
    },
    {
      "osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/arm"
      ],
      "args": [
        {
          "name": "n",
          "type": "int",
          "range": [
            1,
            8
          ]
        },
        {
          "name": "on",
          "type": "bool"
        }
      ],
      "forward": {
        "path": [
          "/track/",
          {
            "capture": "n"
          },
          "/recarm"
        ],
        "args": [
          {
            "arg": "on"
          }
        ]
      }
    },
    {
      "osc": [
        "/scene/",
        {
          "capture": "n"
        },
        "/launch"
      ],
      "args": [
        {
          "name": "n",
          "type": "int",
          "range": [
            1,
            8
          ]
        }
      ],
      "forward": {
        "path": [
          "/scene/",
          {
            "capture": "n"
          },
          "/launch"
        ],
        "args": [
          1
        ]
      }
    }
  ],
  "replies": [
    {
      "match_osc": "/tempo/raw",
      "match_args": [
        {
          "name": "bpm",
          "type": "float"
        }
      ],
      "emit_osc": "/transport/tempo",
      "emit_args": [
        {
          "capture": "bpm"
        }
      ]
    },
    {
      "match_osc": "/play",
      "match_args": [
        {
          "name": "playing",
          "type": "int"
        }
      ],
      "emit_osc": "/transport/playing",
      "emit_args": [
        {
          "capture": "playing"
        }
      ]
    },
    {
      "match_osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/volume"
      ],
      "match_args": [
        {
          "name": "v",
          "type": "float"
        }
      ],
      "emit_osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/volume"
      ],
      "emit_args": [
        {
          "capture": "v"
        }
      ]
    },
    {
      "match_osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/mute"
      ],
      "match_args": [
        {
          "name": "on",
          "type": "int"
        }
      ],
      "emit_osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/mute"
      ],
      "emit_args": [
        {
          "capture": "on"
        }
      ]
    },
    {
      "match_osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/solo"
      ],
      "match_args": [
        {
          "name": "on",
          "type": "int"
        }
      ],
      "emit_osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/solo"
      ],
      "emit_args": [
        {
          "capture": "on"
        }
      ]
    },
    {
      "match_osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/recarm"
      ],
      "match_args": [
        {
          "name": "on",
          "type": "int"
        }
      ],
      "emit_osc": [
        "/track/",
        {
          "capture": "n"
        },
        "/arm"
      ],
      "emit_args": [
        {
          "capture": "on"
        }
      ]
    }
  ],
  "_sources": [
    {
      "type": "third-party-osc",
      "url": "https://github.com/git-moss/DrivenByMoss-Documentation/blob/master/Generic-Tools-Protocols/Open-Sound-Control-(OSC).md",
      "firmware": "Bitwig Studio 5",
      "name": "DrivenByMoss (Bitwig Studio extension)",
      "version": "latest"
    }
  ],
  "_coverage": {
    "commands": 9,
    "host_software": "Bitwig Studio 5 + DrivenByMoss",
    "replies": 6,
    "subscriptions": 0
  },
  "_limitations": "v1 covers transport (play / stop / tempo), per-track volume / mute / solo / arm for the first 8 tracks (DrivenByMoss bank size), and scene launch for the first 8 scenes. Track and scene indices are 1-based in DrivenByMoss (NOT 0-based like AbletonOSC). Browser, devices, automation, and the wider DrivenByMoss surface are out of scope for v1."
}
