{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.roomi-fields/osc-bridge",
  "title": "osc-bridge",
  "description": "OSC ↔ MIDI bridge — 849 synthesizers and DAWs. A MIDI MCP and OSC MCP for controlling them.",
  "repository": {
    "url": "https://github.com/roomi-fields/osc-bridge",
    "source": "github"
  },
  "version": "0.11.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@roomi-fields/osc-bridge",
      "version": "0.11.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "subcommand"
        }
      ]
    }
  ]
}
