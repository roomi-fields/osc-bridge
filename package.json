{
  "name": "osc-bridge-workspace",
  "private": true,
  "description": "The Grillhouse framework for osc-bridge; the engine builds with cargo, and the published npm package lives in npm/.",
  "scripts": {
    "prepare": "grillhouse hooks",
    "tableau": "grillhouse tableau --texte",
    "grillhouse:maj": "grillhouse maj",
    "grillhouse:gardes": "grillhouse gardes-du-cadre",
    "grillhouse:dette:inscrire": "GRILLHOUSE_DETTE=inscrire npm run --silent grillhouse:gardes",
    "grillhouse:dette:elaguer": "GRILLHOUSE_DETTE=elaguer npm run --silent grillhouse:gardes",
    "test": "grillhouse tests",
    "test:forcer": "grillhouse tests --force",
    "verifier": "grillhouse verifier",
    "ci:preparer": "bash scripts/ci_preparer.sh"
  },
  "devDependencies": {
    "@roomi-fields/grillhouse": "^0.51.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "turbo": "2.11.8"
  },
  "grillhouse": {
    "version": "0.51.0",
    "flux": {
      ".github/workflows/ci.yml": [
        "osc-bridge"
      ],
      ".github/workflows/cla.yml": [],
      ".github/workflows/platforms.yml": [
        "osc-bridge"
      ],
      ".github/workflows/release.yml": [
        "osc-bridge"
      ],
      ".github/workflows/version-mirrors.yml": [],
      ".github/workflows/docs.yml": [],
      ".github/workflows/machine-vierge.yml": [
        "osc-bridge"
      ],
      ".github/workflows/nuit.yml": [
        "osc-bridge"
      ]
    },
    "groupe": [
      "../osc-bridge",
      "../synthub-server"
    ],
    "circuits": 2,
    "outil": "0.51.0",
    "part": {
      "coeurs": 3,
      "memoireGo": 2
    }
  },
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "crates/osc-bridge"
  ]
}
