{
  "name": "osc-bridge-workspace",
  "private": true,
  "description": "The Grillhouse framework for osc-bridge; the engine builds with cargo, and the published npm package lives in npm/.",
  "scripts": {
    "prepare": "grillhouse hooks",
    "tableau": "grillhouse tableau --texte",
    "grillhouse:maj": "grillhouse maj",
    "grillhouse:gardes": "grillhouse gardes-du-cadre",
    "grillhouse:dette:inscrire": "GRILLHOUSE_DETTE=inscrire npm run --silent grillhouse:gardes",
    "grillhouse:dette:elaguer": "GRILLHOUSE_DETTE=elaguer npm run --silent grillhouse:gardes",
    "test": "grillhouse tests",
    "test:forcer": "grillhouse tests --force",
    "verifier": "grillhouse verifier"
  },
  "devDependencies": {
    "@roomi-fields/grillhouse": "^0.37.1",
    "smol-toml": "1.9.1",
    "turbo": "2.11.8"
  },
  "grillhouse": {
    "version": "0.37.1",
    "flux": {
      ".github/workflows/ci.yml": [
        "osc-bridge"
      ],
      ".github/workflows/cla.yml": [],
      ".github/workflows/docs.yml": []
    },
    "groupe": [
      "../osc-bridge",
      "../open-synth-descriptors",
      "../synthhub"
    ]
  },
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "crates/osc-bridge"
  ]
}
